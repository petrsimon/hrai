{
  "name": "@hrai/server",
  "version": "0.0.0",
  "description": "Local-model Scratch tutor server and evaluation harness.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build:slot-order": "node scripts/build-slot-order.mjs",
    "eval": "vitest run --reporter=verbose",
    "eval:game-design": "vitest run test/game-design.test.ts --reporter=verbose",
    "lint": "eslint",
    "reset-password": "node --experimental-strip-types scripts/reset-password.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.61",
    "globals": "16.5.0",
    "socket.io-client": "^4.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "nodemailer": "^10.0.0",
    "scratch-l10n": "6.1.111",
    "socket.io": "4.8.1",
    "typebox": "1.3.7"
  }
}
