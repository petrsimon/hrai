# Copy to docker/agent.env and adjust, then:
#   docker compose --env-file docker/agent.env -f docker-compose.agent.yml up -d --build

# Run the tutor container as this host user so the mounted agent home keeps its
# ownership. `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# Agent CLI the tutor spawns: codex or pi.
HRAI_AGENT_BACKEND=codex

# Absolute path to the host `codex` binary (`command -v codex`) and to its home
# directory, which carries the login.
CODEX_BIN=/home/petr/.local/share/mise/installs/codex/latest/bin/codex
CODEX_HOME_HOST_DIR=/home/petr/.codex

# Host directory for profiles and projects. Create it before the first start.
HRAI_DATA_HOST_DIR=./.hrai-data

# Published editor port.
EDITOR_PORT=8080

# Optional: model for the agent CLI; unset uses the CLI's own default.
# HRAI_AGENT_MODEL=gpt-5.2-codex
